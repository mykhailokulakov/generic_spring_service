{
  "realm": "generic",
  "enabled": true,
  "displayName": "Generic (NON-PRODUCTION)",
  "description": "Non-production realm for local development. Seeded users are baked-in test credentials — do NOT use in any deployed environment.",
  "sslRequired": "none",
  "accessTokenLifespan": 3600,
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Administrative role with full access."
      },
      {
        "name": "USER",
        "description": "Standard authenticated user role."
      }
    ]
  },
  "clients": [
    {
      "clientId": "generic-spring-service",
      "name": "Generic Spring Service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "generic-spring-service-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "attributes": {
        "access.token.lifespan": "3600"
      }
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "email": "admin@example.invalid",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": ["ADMIN", "USER"]
    },
    {
      "username": "user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Standard",
      "lastName": "User",
      "email": "user@example.invalid",
      "credentials": [
        {
          "type": "password",
          "value": "user",
          "temporary": false
        }
      ],
      "realmRoles": ["USER"]
    }
  ]
}

# Optional local tracing stack. Copy this file to
# `docker-compose.override.yml` (alongside the same path the main file is
# referenced from), then re-run:
#
#   docker compose -f docker/docker-compose.yml \
#                  -f docker-compose.override.yml up -d
#
# Point the app at the collector by exporting the variable application.yml
# already reads:
#
#   export OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
#
# Uncomment the block below. The OTLP/HTTP receiver on :4318 matches the
# default in application.yml so the application configuration works
# unchanged. Web UI at http://localhost:16686.
#
# We ship only Jaeger because it runs as a single image with no external
# config file. A fork that wants a standalone OpenTelemetry Collector
# can add a service block here and ship its own collector config — we
# deliberately don't bake one in (speculative scaffolding the project
# rules forbid; see DESIGN.md §3.5).

services:
  # jaeger:
  #   image: jaegertracing/all-in-one:1.62
  #   container_name: generic-jaeger
  #   environment:
  #     COLLECTOR_OTLP_ENABLED: "true"
  #   ports:
  #     - "16686:16686"   # UI
  #     - "4318:4318"     # OTLP/HTTP receiver
